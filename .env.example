# SARAL Environment Variables Template
# Copy this file to .env and fill in values
# Same variables work for LOCAL and PRODUCTION (AWS) - just change the values

# ===== Database (PostgreSQL) =====
# LOCAL (PostgreSQL 18 installed natively):
DATABASE_URL="postgresql://saral:postgres@localhost:5432/SaralDB?schema=public"
# PRODUCTION (AWS RDS) example:
# DATABASE_URL="postgresql://saral:STRONG_PASSWORD@saral-db.xxx.ap-south-1.rds.amazonaws.com:5432/saral"

# ===== Redis =====
# LOCAL (Docker):
REDIS_URL="redis://localhost:6379"
# PRODUCTION (AWS ElastiCache):
# REDIS_URL="redis://saral-cache.xxx.ng.0001.aps1.cache.amazonaws.com:6379"

# ===== Object Storage (MinIO Docker / AWS S3) =====
# LOCAL (MinIO via Docker):
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="saral_minio_admin"
S3_SECRET_ACCESS_KEY="saral_minio_password"
S3_BUCKET_VIDEOS="saral-videos"
S3_BUCKET_THUMBNAILS="saral-thumbnails"
S3_PUBLIC_URL="http://localhost:9000"
S3_FORCE_PATH_STYLE="true"

# PRODUCTION (AWS S3) example:
# S3_ENDPOINT=""                                 # Empty for AWS S3
# S3_REGION="ap-south-1"                         # Mumbai region
# S3_ACCESS_KEY_ID="AKIA..."
# S3_SECRET_ACCESS_KEY="..."
# S3_BUCKET_VIDEOS="saral-videos-prod"
# S3_BUCKET_THUMBNAILS="saral-thumbnails-prod"
# S3_PUBLIC_URL="https://saral-videos-prod.s3.ap-south-1.amazonaws.com"
# S3_FORCE_PATH_STYLE="false"

# ===== App Config =====
NEXT_PUBLIC_APP_NAME="SARAL"
NODE_ENV="development"
